---
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索 Hidewnd Docs 的文章。" noindex>
  <header class="page-header search-header">
    <p>SEARCH</p>
    <h1>搜索</h1>
    <span>输入关键词，全文检索标题与正文。</span>
    <PagefindConfig />
    <pagefind-input placeholder="例如：Spring Boot" autofocus></pagefind-input>
  </header>
  <pagefind-summary class="search-status"></pagefind-summary>
  <pagefind-results class="search-results" show-images="false"></pagefind-results>
</BaseLayout>

<script>
  // 顶部搜索框通过 GET /search/?q= 跳转而来，这里预填查询词并触发检索。
  const seedQueryFromUrl = async () => {
    const term = new URLSearchParams(window.location.search).get('q')?.trim();
    if (!term) return;
    await customElements.whenDefined('pagefind-input');
    const input = document.querySelector<HTMLElement & { inputEl?: HTMLInputElement }>('pagefind-input');
    const el = input?.inputEl;
    if (el) {
      el.value = term;
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.focus();
    }
  };
  seedQueryFromUrl();
</script>
