---
import ArticleList from '../../components/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTagSlug } from '../../lib/content';

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}

const { slug } = Astro.props as { slug: string };
const tagInfo = (await getAllTags()).filter((t) => t.slug === slug);
const title = tagInfo.map((t) => t.tag).join(' / ') || slug;
const posts = await getPostsByTagSlug(slug);
---

<BaseLayout title={`标签：#${title}`} description={`标签 ${title} 下的文章。`}>
  <header class="page-header">
    <p>{posts.length} 篇内容</p>
    <h1>#{title}</h1>
    <span>按更新时间倒序排列。</span>
  </header>
  <ArticleList entries={posts} />
</BaseLayout>
