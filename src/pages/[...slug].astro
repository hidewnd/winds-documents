---
import { render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import {
  getCategory,
  getEntryUrl,
  getExcerpt,
  getRoutableDocuments,
  getTags,
  type DocumentEntry,
} from '../lib/content';

export async function getStaticPaths() {
  const entries = await getRoutableDocuments();
  return entries.map((entry) => ({
    params: { slug: getEntryUrl(entry).replace(/^\//, '').replace(/\/$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: DocumentEntry };
const { Content, headings } = await render(entry);
const category = getCategory(entry);
// 与 src/pages/og/[...slug].ts 生成路径保持一致，作为社交平台预览图。
const ogImage = `/og/${getEntryUrl(entry).replace(/^\//, '').replace(/\/$/, '')}.png`;
---

<ArticleLayout
  title={entry.data.title}
  date={entry.data.date}
  category={category}
  description={getExcerpt(entry, 150)}
  image={ogImage}
  tags={getTags(entry)}
  headings={headings.filter(({ depth }) => depth >= 2 && depth <= 3)}
>
  <Content />
</ArticleLayout>
