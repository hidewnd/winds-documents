---
import { Icon } from 'astro-icon/components';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';
import TagList from '../components/TagList.astro';
import 'katex/dist/katex.min.css';

interface ArticleHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  date: Date;
  category: { title: string; href: string };
  description?: string;
  image?: string;
  tags?: string[];
  headings?: ArticleHeading[];
}

const { title, date, category, description, image, tags = [], headings = [] } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <div class="article-layout">
    <article class="post-shell">
      <header class="post-header">
        <a href={category.href}>{category.title}</a>
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <TagList tags={tags} />
      </header>
      <div class="prose"><slot /></div>
    </article>

    {headings.length > 0 && (
      <aside class="article-toc" aria-label="文章大纲">
        <h2 class="toc-title"><Icon name="tabler:list-tree" aria-hidden="true" />文章大纲</h2>
        <ol>
          {headings.map((heading) => (
            <li class:list={[`toc-depth-${heading.depth}`]}>
              <a href={`#${heading.slug}`} title={heading.text}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>

  <button slot="floating" id="back-to-top" class="back-to-top" type="button" data-visible="false" aria-label="返回顶部">
    <Icon name="tabler:arrow-up" aria-hidden="true" />
  </button>
</BaseLayout>

<script>
  const diagrams = Array.from(document.querySelectorAll<HTMLPreElement>('.prose pre.mermaid'), (element) => ({
    element,
    source: element.textContent ?? '',
  }));

  if (diagrams.length > 0) {
    const showError = (element: HTMLElement, source: string, message: string, error: unknown) => {
      const notice = document.createElement('span');
      notice.className = 'mermaid-error';
      notice.setAttribute('role', 'status');
      notice.textContent = message;
      element.replaceChildren(notice, document.createTextNode(`\n\n${source}`));
      delete element.dataset.rendered;
      console.error(message, error);
    };

    void import('mermaid').then(async ({ default: mermaid }) => {
      // 等站点字体就绪再测量标签，避免中文节点宽度按回退字体计算后被裁切。
      await document.fonts.ready;
      let renderId = 0;
      let renderedTheme = '';
      const renderDiagrams = async () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'default';
        if (theme === renderedTheme) return;
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          suppressErrorRendering: true,
          theme,
          fontFamily: getComputedStyle(document.body).fontFamily,
        });
        for (const { element, source } of diagrams) {
          try {
            const { svg, bindFunctions } = await mermaid.render(`mermaid-${renderId++}`, source);
            element.innerHTML = svg;
            // 使用图形自身宽度，窄屏在容器内滚动，避免整张流程图被缩到文字无法阅读。
            const diagramSvg = element.querySelector('svg')!;
            diagramSvg.style.width = `${diagramSvg.viewBox.baseVal.width}px`;
            diagramSvg.style.maxWidth = 'none';
            element.dataset.rendered = 'true';
            bindFunctions?.(element);
          } catch (error) {
            showError(element, source, '流程图渲染失败，请检查 Mermaid 语法。', error);
          }
        }
        renderedTheme = theme;
      };

      // 主题切换与异步绘图串行执行；排队的任务读取当前主题，避免交错写入同一个容器。
      let pending = Promise.resolve();
      const redraw = () => { pending = pending.then(renderDiagrams); };
      const observer = new MutationObserver(redraw);
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      redraw();
      await pending;
    }).catch((error) => {
      for (const { element, source } of diagrams) {
        showError(element, source, '流程图加载失败，请刷新页面重试。', error);
      }
    });
  }
</script>

<script is:inline>
  const backToTop = document.querySelector('#back-to-top');
  const syncBackToTop = () => {
    backToTop?.setAttribute('data-visible', String(window.scrollY > 520));
  };
  backToTop?.addEventListener('click', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });

  const tocLinks = [...document.querySelectorAll('.article-toc a')];
  const headingLinks = new Map(tocLinks.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
  const articleHeadings = [...document.querySelectorAll('.prose h2[id], .prose h3[id]')];
  const syncOutline = () => {
    const current = articleHeadings
      .filter((heading) => heading.getBoundingClientRect().top <= 180)
      .at(-1) ?? articleHeadings[0];
    tocLinks.forEach((link) => link.removeAttribute('aria-current'));
    if (current?.id) headingLinks.get(current.id)?.setAttribute('aria-current', 'location');
  };

  let scrollUpdateQueued = false;
  const syncArticleScrollState = () => {
    if (scrollUpdateQueued) return;
    scrollUpdateQueued = true;
    window.requestAnimationFrame(() => {
      scrollUpdateQueued = false;
      syncBackToTop();
      syncOutline();
    });
  };
  syncBackToTop();
  syncOutline();
  window.addEventListener('scroll', syncArticleScrollState, { passive: true });
</script>
