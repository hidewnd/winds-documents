---
import { Icon } from 'astro-icon/components';
import { site, socialLinks } from '../lib/site';

// 站内链接仍用 astro-icon 渲染，社交链接改由 site.ts 的 socialLinks 配置驱动。
const internalLinks = [
  { href: '/rss.xml', label: 'RSS', icon: 'tabler:rss' },
  { href: '/friends/', label: '友链', icon: 'tabler:bookmarks' },
];
---

<footer class="site-footer">
  <div class="footer-links" aria-label="站点链接">
    {socialLinks.map((link) => (
      <a href={link.link} aria-label={link.title} title={link.title} target="_blank" rel="noopener noreferrer">
        {link.iconUrl ? (
          <img src={link.iconUrl} alt="" loading="lazy" />
        ) : link.icon ? (
          <Icon name={link.icon} aria-hidden="true" />
        ) : (
          <i class={link.iconClass} aria-hidden="true"></i>
        )}
      </a>
    ))}
    {internalLinks.map((link) => (
      <a href={link.href} aria-label={link.label} title={link.label}>
        <Icon name={link.icon} aria-hidden="true" />
      </a>
    ))}
  </div>
  <p>
    <span>Power by Astro</span>
    <span class="footer-divider" aria-hidden="true">|</span>
    <span>Copyright © 2024–{new Date().getFullYear()} {site.author}</span>
  </p>
  <small></small>
</footer>
